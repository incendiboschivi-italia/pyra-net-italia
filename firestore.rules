rules_version = '2';

// Queste regole sono il VERO meccanismo di sicurezza del sistema (non il
// codice del sito, che chiunque può leggere). Vanno incollate in:
// Console Firebase → Firestore Database → Regole.

service cloud.firestore {
  match /databases/{database}/documents {

    // Un utente è un "coordinatore" solo se esiste un documento con il suo
    // stesso UID nella collezione coordinatori. Questi documenti li crea
    // SOLO Gabriele a mano dalla console Firebase, mai il sito.
    function isCoordinatore() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/coordinatori/$(request.auth.uid));
    }

    function ruoloCoordinatore() {
      return get(/databases/$(database)/documents/coordinatori/$(request.auth.uid)).data.ruolo;
    }

    function zonaCoordinatore() {
      return get(/databases/$(database)/documents/coordinatori/$(request.auth.uid)).data.zona;
    }

    function eInterregionale() { return ruoloCoordinatore().matches('.*[Ii]nterregionale.*'); }
    function eProvinciale()    { return ruoloCoordinatore().matches('.*[Pp]rovinciale.*'); }
    // "Regionale" è contenuto anche in "Interregionale": lo escludiamo qui
    // per non confondere i due ruoli.
    function eRegionaleSemplice() {
      return ruoloCoordinatore().matches('.*[Rr]egionale.*') && !eInterregionale();
    }

    // Le regioni di ciascuna macro-area, IDENTICHE a quelle in
    // assets/geocodifica.js — se cambi una lista, cambia anche l'altra.
    function regioniNord() {
      return ["Piemonte", "Valle d'Aosta", "Lombardia", "Trentino-Alto Adige",
              "Veneto", "Friuli-Venezia Giulia", "Liguria", "Emilia-Romagna"];
    }
    function regioniCentro() {
      return ["Toscana", "Umbria", "Marche", "Lazio"];
    }
    function regioniSud() {
      return ["Abruzzo", "Molise", "Campania", "Puglia", "Basilicata",
              "Calabria", "Sicilia", "Sardegna"];
    }
    function regioneNellaZonaInterregionale(regione, zona) {
      return (zona == 'Nord'   && regione in regioniNord()) ||
             (zona == 'Centro' && regione in regioniCentro()) ||
             (zona == 'Sud'    && regione in regioniSud());
    }

    // Un coordinatore può agire su una segnalazione con questi dati
    // (regione/provincia) solo se la zona di competenza corrisponde.
    // Le segnalazioni "non classificate" (geocodifica fallita, regione
    // assente) restano visibili/gestibili solo dagli Interregionali, come
    // rete di sicurezza.
    function puoAgireSullaZona(dati) {
      return isCoordinatore() && (
        (eProvinciale()       && dati.provincia == zonaCoordinatore()) ||
        (eRegionaleSemplice() && dati.regione   == zonaCoordinatore()) ||
        (eInterregionale()    && (
           regioneNellaZonaInterregionale(dati.regione, zonaCoordinatore()) ||
           !('regione' in dati) || dati.regione == null
        ))
      );
    }

    // Direttorio coordinatori: leggibile solo da altri coordinatori loggati.
    // Nessuno può scriverci dal sito: si modifica solo dalla console Firebase.
    match /coordinatori/{uid} {
      allow read: if isCoordinatore();
      allow write: if false;
    }

    // Segnalazioni (cittadine + verificate): un'unica collezione con un
    // campo "stato" che ne segue il ciclo di vita:
    //   in_attesa  → appena inviata da un cittadino, chiunque può crearla
    //   verificata → confermata da un coordinatore della zona competente
    //   rifiutata  → scartata da un coordinatore della zona competente
    match /segnalazioni/{docId} {
      // Lettura pubblica: la mappa la mostra a tutti, verificate o in attesa.
      allow read: if true;

      allow create: if
        // Un cittadino (chiunque, anche senza login) può creare una
        // segnalazione, ma SOLO con stato "in_attesa", coordinate numeriche
        // e una descrizione non vuota.
        (request.resource.data.stato == 'in_attesa'
          && request.resource.data.lat is number
          && request.resource.data.lon is number
          && request.resource.data.descrizione is string
          && request.resource.data.descrizione.size() > 0)
        ||
        // Un coordinatore può registrare direttamente un incidente GIÀ
        // verificato, ma solo dentro la propria zona di competenza.
        (request.resource.data.stato == 'verificata'
          && request.resource.data.verificato_da is string
          && puoAgireSullaZona(request.resource.data));

      // Solo un coordinatore della zona competente (Interregionale, Regionale
      // o Provinciale a seconda della segnalazione) può cambiare lo stato.
      allow update: if puoAgireSullaZona(resource.data);

      allow delete: if false;
    }

    // Richieste di rimozione: un coordinatore Regionale propone di togliere
    // dalla mappa un rilevamento satellitare o una segnalazione, motivando
    // il perché. Il punto sparisce dalla mappa SOLO dopo che un
    // coordinatore Interregionale approva la richiesta.
    match /richieste_rimozione/{docId} {
      // Lettura riservata ai coordinatori (è una coda di lavoro interna).
      allow read: if isCoordinatore();

      // Solo un coordinatore Regionale (non Provinciale, non Interregionale)
      // può proporre una rimozione, e solo motivandola.
      allow create: if eRegionaleSemplice()
                    && request.resource.data.stato == 'in_attesa'
                    && request.resource.data.motivazione is string
                    && request.resource.data.motivazione.size() > 0
                    && request.resource.data.tipo in ['satellite', 'segnalazione'];

      // Solo un coordinatore Interregionale può accettare o rifiutare la
      // richiesta (mai il contrario: una volta decisa, resta decisa).
      allow update: if eInterregionale()
                    && resource.data.stato == 'in_attesa'
                    && request.resource.data.stato in ['approvata', 'rifiutata'];

      allow delete: if false;
    }

    // Tutto il resto è vietato di default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
