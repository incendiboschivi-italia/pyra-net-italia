rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isCoordinatore() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/coordinatori/$(request.auth.uid));
    }

    function ruoloCoordinatore() {
      return get(/databases/$(database)/documents/coordinatori/$(request.auth.uid)).data.ruolo;
    }

    function zonaCoordinatore() {
      return get(/databases/$(database)/documents/coordinatori/$(request.auth.uid)).data.zona;
    }
function eInterregionale() { return ruoloCoordinatore().matches('.*[Ii]nterregionale.*'); }
    function eProvinciale()    { return ruoloCoordinatore().matches('.*[Pp]rovinciale.*'); }
    function eRegionaleSemplice() {
      return ruoloCoordinatore().matches('.*[Rr]egionale.*') && !eInterregionale();
    }

    function regioniNord() {
      return ["Piemonte", "Valle d'Aosta", "Lombardia", "Trentino-Alto Adige",
              "Veneto", "Friuli-Venezia Giulia", "Liguria", "Emilia-Romagna"];
    }
    function regioniCentro() {
      return ["Toscana", "Umbria", "Marche", "Lazio"];
    }
    function regioniSud() {
      return ["Abruzzo", "Molise", "Campania", "Puglia", "Basilicata",
              "Calabria", "Sicilia", "Sardegna"];
    }
    function regioneNellaZonaInterregionale(regione, zona) {
      return (zona == 'Nord'   && regione in regioniNord()) ||
             (zona == 'Centro' && regione in regioniCentro()) ||
             (zona == 'Sud'    && regione in regioniSud());
    }
function puoAgireSullaZona(dati) {
      return isCoordinatore() && (
        (eProvinciale()       && dati.provincia == zonaCoordinatore()) ||
        (eRegionaleSemplice() && dati.regione   == zonaCoordinatore()) ||
        (eInterregionale()    && (
           regioneNellaZonaInterregionale(dati.regione, zonaCoordinatore()) ||
           !('regione' in dati) || dati.regione == null
        ))
      );
    }

    match /coordinatori/{uid} {
      allow read: if isCoordinatore();
      allow write: if false;
    }
match /segnalazioni/{docId} {
      allow read: if true;

      allow create: if
        (request.resource.data.stato == 'in_attesa'
          && request.resource.data.lat is number
          && request.resource.data.lon is number
          && request.resource.data.descrizione is string
          && request.resource.data.descrizione.size() > 0)
        ||
        (request.resource.data.stato == 'verificata'
          && request.resource.data.verificato_da is string
          && puoAgireSullaZona(request.resource.data));

      allow update: if puoAgireSullaZona(resource.data);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
